# ─── Server timezone ───────────────────────────────────────────────
# IANA timezone name used by the Node.js process (affects logs, date
# calculations, monthly SMS stats buckets, etc.).
# NTP (system clock sync) must be configured at OS level (e.g.
#   Linux:   timedatectl set-timezone Europe/Rome && systemctl restart systemd-timesyncd
#   Windows: Set-TimeZone -Id 'W. Europe Standard Time'
# Uncomment and set to your server's local timezone:
TZ=Europe/Rome

# ─── Backend ────────────────────────────────────────────────────────
# Port on which the backend starts
PORT=4673
# Log level: error | warn | info | debug
LOG_LEVEL=info
# Allowed CORS origins (* = all, or e.g. http://192.168.1.50:3000)
CORS_ORIGIN=*

# ─── Authentication ─────────────────────────────────────────────────
# Super-admin created/updated at every startup (not editable from the UI)
SUPERADMIN_USERNAME=sysadmin
SUPERADMIN_PASSWORD=Password!
# JWT secret — CHANGE to a long random string in production!
# Example: openssl rand -hex 64
JWT_SECRET=changeme-use-a-long-random-string-in-production
# JWT token duration (e.g. 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# ─── Encryption key for secrets stored in the DB ────────────────────
# Protects LDAP/SMTP passwords saved in the SQLite database.
# MUST be identical on ALL environments that share the same database
# (dev, Docker, migration to another server, etc.).
# If not set, falls back to JWT_SECRET — but since JWT_SECRET often changes
# between environments, it is STRONGLY recommended to set this explicitly.
# If you change this value, re-enter all passwords in Settings (LDAP, SMTP).
# Generate: openssl rand -hex 32
ENCRYPTION_SECRET=changeme-use-a-long-random-string-different-from-jwt

# ─── SSO via reverse proxy (Authentik, NetScaler ADC, Nginx, etc.) ──
# Enables the GET /api/auth/sso endpoint that accepts the user from the
# HTTP header injected by the reverse proxy (the proxy handles SAML/OAuth/LDAP,
# then injects the header).
# SECURITY: make sure the proxy cannot be bypassed from outside!
# SSO_ENABLED=true
# HTTP header in which the proxy injects the authenticated username
# SSO_HEADER=X-Remote-User

# ─── Frontend (Docker only) ─────────────────────────────────────────
# Port exposed externally by the nginx container
FRONTEND_PORT=4674

# ─────────────────────────────────────────────────────────────────────
# Yeastar devices and SMTP configuration do NOT go in .env.
# They are configured from the web interface (/devices and /settings)
# and stored in the SQLite database.
#
# SAML 2.0 (NetScaler, ADFS, Azure AD):
#   SAML configuration is managed entirely from the web interface
#   → Settings → SAML / SSO (visible to Superadmin only).
#   No .env variables are needed for SAML.
#   The IdP will receive:  ACS URL = https://yourdomain/api/auth/saml/callback
#                          SP Entity ID = https://yourdomain/api/auth/saml/metadata
# ─────────────────────────────────────────────────────────────────────
