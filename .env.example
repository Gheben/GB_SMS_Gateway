# ─── Backend ────────────────────────────────────────────────────────
# Porta su cui si avvia il backend
PORT=4673
# Livello di log: error | warn | info | debug
LOG_LEVEL=info
# Origini CORS ammesse (* = tutte, oppure es. http://192.168.1.50:3000)
CORS_ORIGIN=*

# ─── Autenticazione ─────────────────────────────────────────────────
# Super-admin creato/aggiornato ad ogni avvio (non modificabile dall'UI)
SUPERADMIN_USERNAME=sysadmin
SUPERADMIN_PASSWORD=Password!
# Segreto JWT — CAMBIA con una stringa lunga e casuale in produzione!
# Esempio: openssl rand -hex 64
JWT_SECRET=changeme-use-a-long-random-string-in-production
# Durata del token JWT (es. 8h, 1d, 7d)
JWT_EXPIRES_IN=8h

# ─── SSO tramite proxy (Authentik, NetScaler ADC, Nginx, ecc.) ──────
# Attiva l'endpoint GET /api/auth/sso che accetta l'utente dall'header HTTP
# del proxy reverse (il proxy fa il SAML/OAuth/LDAP, poi inietta l'header).
# SICUREZZA: assicurati che il proxy non sia bypassabile dall'esterno!
# SSO_ENABLED=true
# Header HTTP in cui il proxy inietta lo username autenticato
# SSO_HEADER=X-Remote-User

# ─── Frontend (solo Docker) ─────────────────────────────────────────
# Porta esposta all'esterno dal container nginx
FRONTEND_PORT=4674

# ─────────────────────────────────────────────────────────────────────
# Dispositivi Yeastar e configurazione SMTP NON vanno nel .env.
# Si configurano dall'interfaccia web (/devices e /settings)
# e vengono salvati nel database SQLite.
#
# SAML 2.0 (NetScaler, ADFS, Azure AD):
#   La configurazione SAML è gestita interamente dall'interfaccia web
#   → Impostazioni → SAML / SSO (visibile solo al Superadmin).
#   Non è necessaria nessuna variabile .env per SAML.
#   L'IdP riceverà:  ACS URL = https://tuodominio/api/auth/saml/callback
#                    SP Entity ID = https://tuodominio/api/auth/saml/metadata
# ─────────────────────────────────────────────────────────────────────
